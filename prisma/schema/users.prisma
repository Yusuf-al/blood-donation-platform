model User {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique
  passwordHash String
  phone        String?    @unique
  role         UserRole  @default(REQUESTER)
  status       UserStatus @default(ACTIVE)

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  donorProfile DonorProfile?
  requests     BloodRequest[] @relation("RequesterRequests")
  assignments  DonationAssignment[] @relation("DonorAssignments")
  payments     Payment[]
 

  @@index([role, status])
  @@index([deletedAt])

  @@map("users")
}