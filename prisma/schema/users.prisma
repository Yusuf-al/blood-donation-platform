model User {
  id                  String          @id @default(uuid())
  name                String
  email               String          @unique
  passwordHash        String?
  googleId            String?         @unique
  authProvider        AuthProvider    @default(CREDENTIAL)

  phone               String?         @unique
  role                UserRole        @default(REQUESTER)
  status              UserStatus      @default(ACTIVE)
  isPremiumUser       Boolean         @default(false)

  imageUrl            String          @default("")
  imagePublicId       String          @default("")

  isVerified          Boolean         @default(false)
  isDeleted           Boolean         @default(false)

  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  deletedAt           DateTime?

  donorProfile        DonorProfile?
  requests            BloodRequest[]  @relation("RequesterRequests")
  assignments         DonationAssignment[] @relation("DonorAssignments")
  payments            Payment[]
  requestUsage        MonthlyRequestUsage[]
  subscription        Subscription[]
 

  @@index([role, status])
  @@index([deletedAt])

  @@map("users")
}