model Subscription {
  id              String             @id @default(uuid())
  userId          String
 
  status          SubscriptionStatus @default(PENDING)

  startedAt       DateTime?
  expiresAt       DateTime?
  

  user            User               @relation(fields: [userId], references: [id])
  payments        Payment?

  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([userId, status])
  @@index([expiresAt])

  @@map("subscriptions")
}