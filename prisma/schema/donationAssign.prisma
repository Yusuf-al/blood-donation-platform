model DonationAssignment {
  id             String           @id @default(uuid())
  requestId      String
  donorId        String
  status         AssignmentStatus @default(CREATED)
  assignedAt     DateTime         @default(now())
  respondedAt    DateTime?

  request        BloodRequest @relation(fields: [requestId], references: [id])
  donor          User @relation("DonorAssignments", fields: [donorId], references: [id])
  donorProfile   DonorProfile @relation(fields: [donorProfileId], references: [id])
  donorProfileId String
  donationRecord DonationRecord?

  @@unique([requestId, donorId])
  @@index([donorId, status])
  @@index([requestId, status])
}